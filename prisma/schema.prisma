generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Stage {
  wishlist
  applied
  interview
  offer
  rejected
  ghosted
}

enum Source {
  linkedin
  referral
  company_site
  job_board
  other
}

model Application {
  id              String           @id @default(cuid())
  userId          String
  company         String
  roleTitle       String
  jobUrl          String?
  location        String?
  source          Source?
  dateApplied     DateTime?
  contactName     String?
  contactEmail    String?
  salaryRange     String?
  stage           Stage            @default(wishlist)
  followUpDate    DateTime?
  isStarred       Boolean          @default(false)
  notes           String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  stageHistory    StageHistory[]
  interviewRounds InterviewRound[]
  ghostSnoozes    GhostSnooze[]

  @@index([userId])
  @@index([userId, stage])
  @@index([userId, updatedAt])
  @@index([userId, followUpDate])
  @@index([userId, createdAt])
}

model StageHistory {
  id            String      @id @default(cuid())
  applicationId String
  fromStage     Stage?
  toStage       Stage
  changedAt     DateTime    @default(now())

  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
}

model InterviewRound {
  id            String      @id @default(cuid())
  applicationId String
  label         String
  date          DateTime?
  createdAt     DateTime    @default(now())

  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
}

model UserSettings {
  id                 String   @id @default(cuid())
  userId             String   @unique
  ghostThresholdDays Int      @default(14)
  emailDigestEnabled Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model GhostSnooze {
  id            String      @id @default(cuid())
  userId        String
  applicationId String
  snoozedUntil  DateTime
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([userId, applicationId])
  @@index([userId, snoozedUntil])
}
